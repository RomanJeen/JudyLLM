# Which backend to hit: local | dev | stg
EVAL_TARGET=local

LOCAL_BACKEND_URL=http://localhost:4000
LOCAL_API_KEY=test123

# Base URL only (script appends /api/v1/agent/chat). Full chat URL also accepted.
DEV_BACKEND_URL=https://askpola-v2-dev.jeen-sp.app
DEV_API_KEY=

# AskPola staging. STG_API_KEY falls back to DEV_API_KEY when empty.
STG_BACKEND_URL=https://askpola-v2-stg.jeen-sp.app
STG_API_KEY=

# Mitve Miluim. Used when EVAL_TARGET=miluim-dev or miluim-stg and CLIENT_ID is empty.
MILUIM_DEV_BACKEND_URL=https://miluim-agent-dev.jeen-sp.app
MILUIM_DEV_API_KEY=

MILUIM_STG_BACKEND_URL=https://miluim-agent-stg.jeen-sp.app
MILUIM_STG_API_KEY=

# Optional override. When set, this client ID is sent for every target
# (local, dev, custom) and wins over LOCAL_API_KEY / DEV_API_KEY / API_KEY.
# Leave empty to keep per-target keys. Override at runtime with:
#   CLIENT_ID=local-client npm run eval:dev
CLIENT_ID=

# Optional. auto = mint x-pola-session-token via POST /api/v1/agent/session,
# and fall back to legacy eval-* ids if that endpoint is missing (other projects).
# required = fail if session minting fails. off = never mint (legacy only).
CHAT_SESSION_MODE=auto

LIMIT=0
CONCURRENCY=2
# Min delay between chat POST starts. 3000ms keeps sustained traffic under the ~20/min dev quota.
STAGGER_MS=3000
AGENT_MAX_RETRIES=8
AGENT_RETRY_BASE_MS=10000
AGENT_RETRY_MAX_MS=60000

# Used by run-phoenix-calibration.mjs. The eval runner uses CONCURRENCY instead.
DELAY_MS=1500

# AWS Bedrock judge credentials.
# You can copy these from askpola-backend/.env for local runs.
AWS_REGION=eu-west-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Optional. Override Judy's judge system prompt for a CLI run.
# The UI first rubric edits this for the spawned run.
# JUDGE_SYSTEM_PROMPT=

JUDGE_MODEL=eu.anthropic.claude-haiku-5-5
# Leave empty for Haiku 5.5, which rejects temperature. Set 0 for older models.
JUDGE_TEMPERATURE=
JUDGE_MAX_TOKENS=1536
# Per-question interview cap. Advice-flow runs should use 12.
JUDGE_MAX_AGENT_TURNS=4
JUDGE_MAX_RETRIES=4
# Bedrock connect/read timeouts. Connection timeouts are retried.
JUDGE_CONNECTION_TIMEOUT_MS=30000
JUDGE_REQUEST_TIMEOUT_MS=60000
# Cap parallel Bedrock judge calls even when eval concurrency is higher.
JUDGE_INVOKE_CONCURRENCY=4
# Used only by the local Bedrock judge. Comma-separated DNS servers.
JUDGE_DNS_SERVERS=8.8.8.8,1.1.1.1
